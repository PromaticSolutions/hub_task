# Copie para .env para usar o Supabase também no desenvolvimento local.
# Sem estas variáveis, `npm run dev` usa o arquivo local data/db.json.
# Na Vercel, cadastre as mesmas variáveis em Settings → Environment Variables.

# Supabase → Connect → "Transaction pooler" (porta 6543), com a senha do banco.
DATABASE_URL=postgresql://postgres.SEU-PROJETO:SUA-SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Supabase → Project Settings → API (use a chave service_role / secret, nunca exponha no frontend).
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: nome do bucket de anexos (criado automaticamente, privado).
# SUPABASE_BUCKET=attachments
